# 백엔드 서버 주소
# 이 파일을 .env.local 로 복사한 뒤 값을 채워주세요.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
VITE_KAKAO_CLIENT_ID=

# Kakao Developers > 제품 설정 > 카카오 로그인 > Redirect URI에 같은 값을 등록해야 합니다.
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao/callback
